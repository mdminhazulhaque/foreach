#!/bin/bash

usage()
{
    echo "Usage: foreach FILENAME COMMAND" > /dev/stderr
    echo "       cat FILENAME | foreach COMMAND" > /dev/stderr
    echo "       COMMAND: A string with {} which will be replaced with LINE from FILENAME" > /dev/stderr
    exit 1
}

# pass nothing, do nothing
if [ $# -lt 1 ]
then
    usage
fi

# piped mode
if [ ! -t 0 ]
then
    filename=/dev/stdin
else
    if [ ! -f "$1" ]
    then
        echo "Cannot open file $1 for reading" > /dev/stderr
        exit 1
    fi
    filename="$1"; shift
fi

if echo "$@" | grep -q '{}'
then
    replace=Yes
else
    replace=No
fi

cat "$filename" | while read -r line || [ -n "$line" ]
do
    if [ "$replace" == "No" ]
    then
        # execute the command with line string as argument
        "$@" "$line"
    else
        # replace {} with line content using awk to avoid sed metacharacter issues
        exec_str=$(echo "$*" | awk -v val="$line" '{gsub(/\{\}/, val); print}')
        eval "$exec_str"
    fi
done

exit 0
